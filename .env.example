# Docker Compose Configuration
COMPOSE_PROJECT_NAME=staticmaker

# Application Configuration
WEB_PORT=8080
LOG_LEVEL=DEBUG
SHOW_SQL=false

# JWT Configuration (IMPORTANT: Change this in production!)
JWT_SECRET=ChangeThisToAStrongSecretKeyWith256BitsMinimumForProductionUseGeneratedRandomly
JWT_EXPIRATION=86400000

# FFLogs API Configuration
# Get your API credentials from: https://www.fflogs.com/api/clients
# Leave empty to skip character validation (not recommended for production)
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

# Timezone
TIMEZONE=UTC

# MySQL Configuration
MYSQL_VERSION=8.0
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fflog
MYSQL_USER=fflog_user
MYSQL_PASSWORD=fflog_password
